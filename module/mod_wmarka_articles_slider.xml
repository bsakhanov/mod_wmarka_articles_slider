<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_WMARKA_ARTICLES_SLIDER</name>
    <author>Beibit Sakhanov</author>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 Beibit Sakhanov</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorUrl>https://webmarka.kz</authorUrl>
    <version>1.1.0</version>
    <description>MOD_WMARKA_ARTICLES_SLIDER_DESC</description>
    <namespace path="src">Webmarka\Module\ArticlesSlider</namespace>

    <files>
        <folder module="mod_wmarka_articles_slider">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages>
        <language tag="ru-RU">language/ru-RU/mod_wmarka_articles_slider.ini</language>
        <language tag="ru-RU">language/ru-RU/mod_wmarka_articles_slider.sys.ini</language>
        <language tag="en-GB">language/en-GB/mod_wmarka_articles_slider.ini</language>
        <language tag="en-GB">language/en-GB/mod_wmarka_articles_slider.sys.ini</language>
        <language tag="kk-KZ">language/kk-KZ/mod_wmarka_articles_slider.ini</language>
        <language tag="kk-KZ">language/kk-KZ/mod_wmarka_articles_slider.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="MOD_WMARKA_ARTICLES_SLIDER_FIELDSET_BASIC_LABEL">
                <field name="mode" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_MODE_LABEL" default="normal">
                    <option value="normal">MOD_WMARKA_ARTICLES_SLIDER_OPTION_NORMAL_VALUE</option>
                    <option value="dynamic">MOD_WMARKA_ARTICLES_SLIDER_OPTION_DYNAMIC_VALUE</option>
                </field>
                <field name="show_on_article_page" type="radio" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SHOWONARTICLEPAGE_LABEL" default="1" layout="joomla.form.field.radio.switcher" showon="mode:dynamic">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="catid" type="category" extension="com_content" multiple="true" label="JCATEGORY" layout="joomla.form.field.list-fancy-select" filter="intarray" class="multipleCategories" showon="mode:normal" />
                <field name="show_child_category_articles" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_CHILDCAT_LABEL" default="0" filter="integer">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="levels" type="number" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_CATDEPTH_LABEL" default="1" filter="integer" showon="show_child_category_articles:1" />
                
                <field name="count" type="number" default="5" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_COUNT_LABEL" class="form-control" />
                <field name="show_introtext" type="radio" default="1" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SHOWINTROTEXT_LABEL" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="introtext_limit" type="number" default="150" min="0" filter="integer" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTROLIMIT_LABEL" class="form-control" showon="show_introtext:1" />
                <field name="introtext_truncate" type="list" default="chars" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_TRUNCATE_LABEL" class="form-select" showon="show_introtext:1">
                    <option value="chars">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TRUNCATE_CHARS</option>
                    <option value="words">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TRUNCATE_WORDS</option>
                </field>
                <field name="introtext_format" type="list" default="plain" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_FORMAT_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_FORMAT_DESC" class="form-select" showon="show_introtext:1">
                    <option value="plain">MOD_WMARKA_ARTICLES_SLIDER_OPTION_FORMAT_PLAIN</option>
                    <option value="html">MOD_WMARKA_ARTICLES_SLIDER_OPTION_FORMAT_HTML</option>
                </field>
                <field name="articles_layout" type="list" default="items" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_LAYOUT_LABEL" class="form-select">
                    <option value="items">MOD_WMARKA_ARTICLES_SLIDER_OPTION_LAYOUT_ITEMS</option>
                    <option value="titles">MOD_WMARKA_ARTICLES_SLIDER_OPTION_LAYOUT_TITLES</option>
                </field>
            </fieldset>

            <fieldset name="filtering" label="MOD_WMARKA_ARTICLES_SLIDER_FIELDSET_FILTERING_LABEL">
                <field name="show_featured" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_FEATURED_LABEL" default="show">
                    <option value="show">JSHOW</option>
                    <option value="hide">JHIDE</option>
                    <option value="only">MOD_WMARKA_ARTICLES_SLIDER_OPTION_ONLY</option>
                </field>
                <field name="filter_tag" type="tag" label="JTAG" mode="nested" multiple="true" filter="intarray" class="multipleTags" />
                
                <field name="author_filtering_type" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_AUTHORFILTER_LABEL" default="1" filter="integer">
                    <option value="0">MOD_WMARKA_ARTICLES_SLIDER_OPTION_EXCLUDE</option>
                    <option value="1">MOD_WMARKA_ARTICLES_SLIDER_OPTION_INCLUDE</option>
                    <option value="2">MOD_WMARKA_ARTICLES_SLIDER_OPTION_CURRENTUSER</option>
                </field>
                <field name="created_by" type="author" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_AUTHOR_LABEL" multiple="true" layout="joomla.form.field.list-fancy-select" filter="intarray" class="multipleAuthors" showon="author_filtering_type!:2" />
                
                <field name="date_filtering" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_DATEFILTER_LABEL" default="off">
                    <option value="off">MOD_WMARKA_ARTICLES_SLIDER_OPTION_OFF</option>
                    <option value="range">MOD_WMARKA_ARTICLES_SLIDER_OPTION_DATERANGE</option>
                    <option value="relative">MOD_WMARKA_ARTICLES_SLIDER_OPTION_RELATIVEDATE</option>
                </field>
                <field name="date_field" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_DATEFIELD_LABEL" default="a.created" showon="date_filtering!:off">
                    <option value="a.created">MOD_WMARKA_ARTICLES_SLIDER_OPTION_CREATED</option>
                    <option value="a.modified">MOD_WMARKA_ARTICLES_SLIDER_OPTION_MODIFIED</option>
                    <option value="a.publish_up">MOD_WMARKA_ARTICLES_SLIDER_OPTION_PUBLISHED</option>
                </field>
                <field name="start_date_range" type="calendar" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_STARTDATE_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="date_filtering:range" />
                <field name="end_date_range" type="calendar" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_ENDDATE_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="date_filtering:range" />
                <field name="relative_date" type="number" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_RELATIVEDAYS_LABEL" default="30" filter="integer" showon="date_filtering:relative" />
            </fieldset>

            <fieldset name="ordering" label="MOD_WMARKA_ARTICLES_SLIDER_FIELDSET_ORDERING_LABEL">
                <field name="article_ordering" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_ORDERING_LABEL" default="a.title">
                    <option value="a.ordering">MOD_WMARKA_ARTICLES_SLIDER_OPTION_ORDERING</option>
                    <option value="fp.ordering">MOD_WMARKA_ARTICLES_SLIDER_OPTION_ORDERING_FEAT</option>
                    <option value="a.title">JGLOBAL_TITLE</option>
                    <option value="a.id">ID</option>
                    <option value="a.created">MOD_WMARKA_ARTICLES_SLIDER_OPTION_CREATED</option>
                    <option value="modified">MOD_WMARKA_ARTICLES_SLIDER_OPTION_MODIFIED</option>
                    <option value="publish_up">MOD_WMARKA_ARTICLES_SLIDER_OPTION_PUBLISHED</option>
                    <option value="random">MOD_WMARKA_ARTICLES_SLIDER_OPTION_RANDOM</option>
                    <option value="a.hits">MOD_WMARKA_ARTICLES_SLIDER_OPTION_HITS</option>
                </field>
                <field name="article_ordering_direction" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_ORDERDIR_LABEL" default="ASC">
                    <option value="DESC">MOD_WMARKA_ARTICLES_SLIDER_OPTION_DESC</option>
                    <option value="ASC">MOD_WMARKA_ARTICLES_SLIDER_OPTION_ASC</option>
                </field>
                
                <field type="spacer" name="sp_grouping" label="MOD_WMARKA_ARTICLES_SLIDER_FIELDSET_GROUPING_LABEL" hr="true" />
                <field name="article_grouping" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_GROUPING_LABEL" default="none">
                    <option value="none">JNONE</option>
                    <option value="year">MOD_WMARKA_ARTICLES_SLIDER_OPTION_YEAR</option>
                    <option value="month_year">MOD_WMARKA_ARTICLES_SLIDER_OPTION_MONTH_YEAR</option>
                    <option value="author">JAUTHOR</option>
                    <option value="category_title">JCATEGORY</option>
                    <option value="tags">JTAG</option>
                </field>
                <field name="article_grouping_direction" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_GROUPDIR_LABEL" default="ksort" showon="article_grouping!:none">
                    <option value="krsort">MOD_WMARKA_ARTICLES_SLIDER_OPTION_DESC</option>
                    <option value="ksort">MOD_WMARKA_ARTICLES_SLIDER_OPTION_ASC</option>
                </field>
            </fieldset>

            <fieldset name="uikit_design" label="MOD_WMARKA_ARTICLES_SLIDER_FIELDSET_UIKIT_LABEL">
                <field type="spacer" name="sp_header" label="MOD_WMARKA_ARTICLES_SLIDER_SP_HEADER_LABEL" hr="true" />
                <field name="custom_header" type="text" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_HEADER_TEXT_LABEL" class="form-control" />
                <field name="header_link" type="url" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_HEADER_LINK_LABEL" class="form-control" />
                <field name="header_tag" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_HEADER_TAG_LABEL" default="h2" class="form-select">
                    <option value="h1">H1</option><option value="h2">H2</option><option value="h3">H3</option><option value="h4">H4</option><option value="h5">H5</option><option value="h6">H6</option><option value="div">DIV</option>
                </field>
                <field name="header_size" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SIZE_CLASS_LABEL" default="" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_SLIDER_OPTION_SIZE_NONE</option>
                    <option value="uk-h1">uk-h1</option>
                    <option value="uk-h2">uk-h2</option>
                    <option value="uk-h3">uk-h3</option>
                    <option value="uk-h4">uk-h4</option>
                    <option value="uk-h5">uk-h5</option>
                    <option value="uk-h6">uk-h6</option>
                    <option value="uk-heading-small">uk-heading-small</option>
                    <option value="uk-heading-medium">uk-heading-medium</option>
                    <option value="uk-heading-large">uk-heading-large</option>
                    <option value="uk-heading-xlarge">uk-heading-xlarge</option>
                </field>
                <field name="header_class" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_HEADER_CLASS_LABEL" default="uk-heading-line" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_SLIDER_OPTION_HEADCLASS_NONE</option>
                    <option value="uk-heading-line">MOD_WMARKA_ARTICLES_SLIDER_OPTION_HEADCLASS_LINE</option>
                    <option value="uk-heading-bullet">MOD_WMARKA_ARTICLES_SLIDER_OPTION_HEADCLASS_BULLET</option>
                    <option value="uk-heading-divider">MOD_WMARKA_ARTICLES_SLIDER_OPTION_HEADCLASS_DIVIDER</option>
                </field>
                <field name="header_link_class" type="radio" default="1" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_HEADER_LINKCLASS_LABEL" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>

                <field type="spacer" name="sp_layout" label="MOD_WMARKA_ARTICLES_SLIDER_SP_CARD_LAYOUT_LABEL" hr="true" />
                <field name="card_media_pos" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_MEDIA_POS_LABEL" default="top" class="form-select">
                    <option value="top">MOD_WMARKA_ARTICLES_SLIDER_OPTION_POS_TOP</option>
                    <option value="bottom">MOD_WMARKA_ARTICLES_SLIDER_OPTION_POS_BOTTOM</option>
                    <option value="left">MOD_WMARKA_ARTICLES_SLIDER_OPTION_POS_LEFT</option>
                    <option value="right">MOD_WMARKA_ARTICLES_SLIDER_OPTION_POS_RIGHT</option>
                    <option value="zebra-v">MOD_WMARKA_ARTICLES_SLIDER_OPTION_POS_ZEBRA_V</option>
                    <option value="zebra-h">MOD_WMARKA_ARTICLES_SLIDER_OPTION_POS_ZEBRA_H</option>
                </field>
                <field name="card_structure" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_CARD_STRUCT_LABEL" default="body-only" class="form-select">
                    <option value="body-only">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STRUCT_BODY</option>
                    <option value="header-body">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STRUCT_HB</option>
                    <option value="body-footer">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STRUCT_BF</option>
                    <option value="header-body-footer">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STRUCT_HBF</option>
                </field>

                <field type="spacer" name="sp_typo" label="MOD_WMARKA_ARTICLES_SLIDER_SP_TYPO_LABEL" hr="true" />
                <field name="item_heading_tag" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_ITEM_TAG_LABEL" default="h3" class="form-select">
                    <option value="h1">H1</option><option value="h2">H2</option><option value="h3">H3</option><option value="h4">H4</option><option value="h5">H5</option><option value="h6">H6</option><option value="div">DIV</option>
                </field>
                <field name="item_heading_size" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SIZE_CLASS_LABEL" default="" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_SLIDER_OPTION_SIZE_NONE</option>
                    <option value="uk-h1">uk-h1</option>
                    <option value="uk-h2">uk-h2</option>
                    <option value="uk-h3">uk-h3</option>
                    <option value="uk-h4">uk-h4</option>
                    <option value="uk-h5">uk-h5</option>
                    <option value="uk-h6">uk-h6</option>
                    <option value="uk-heading-small">uk-heading-small</option>
                    <option value="uk-heading-medium">uk-heading-medium</option>
                    <option value="uk-heading-large">uk-heading-large</option>
                    <option value="uk-text-lead">uk-text-lead</option>
                    <option value="uk-text-large">uk-text-large</option>
                </field>
                <field name="title_classes" type="text" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_TITLE_CLASS_LABEL" default="uk-card-title uk-link-heading" class="form-control" />
                <field type="spacer" name="sp_intro" label="MOD_WMARKA_ARTICLES_SLIDER_SP_INTRO_LABEL" hr="true" />
                <field name="intro_size" type="list" default="uk-text-small" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_SIZE_LABEL" class="form-select">
                    <option value="">JDEFAULT</option>
                    <option value="uk-text-meta">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_META</option>
                    <option value="uk-text-small">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_SMALL</option>
                    <option value="uk-text-large">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_LARGE</option>
                    <option value="uk-text-lead">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_LEAD</option>
                </field>
                <field name="intro_color" type="list" default="uk-text-muted" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_COLOR_LABEL" class="form-select">
                    <option value="">JDEFAULT</option>
                    <option value="uk-text-muted">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLOR_MUTED</option>
                    <option value="uk-text-emphasis">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLOR_EMPHASIS</option>
                    <option value="uk-text-primary">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLOR_PRIMARY</option>
                    <option value="uk-text-secondary">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLOR_SECONDARY</option>
                </field>
                <field name="intro_style" type="list" default="" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_STYLE_LABEL" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STYLE_NORMAL</option>
                    <option value="uk-text-italic">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STYLE_ITALIC</option>
                    <option value="uk-text-light">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STYLE_LIGHT</option>
                    <option value="uk-text-bold">MOD_WMARKA_ARTICLES_SLIDER_OPTION_STYLE_BOLD</option>
                </field>
                <field name="intro_align" type="list" default="" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_ALIGN_LABEL" class="form-select">
                    <option value="">JDEFAULT</option>
                    <option value="uk-text-left">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_LEFT</option>
                    <option value="uk-text-center">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_CENTER</option>
                    <option value="uk-text-right">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_RIGHT</option>
                    <option value="uk-text-justify">MOD_WMARKA_ARTICLES_SLIDER_OPTION_TEXT_JUSTIFY</option>
                </field>
                <field name="intro_clamp" type="number" default="0" min="0" max="20" filter="integer" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_CLAMP_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_CLAMP_DESC" class="form-control" />
                <field name="intro_classes" type="text" default="" hint="uk-margin-small-top" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_INTRO_CLASS_LABEL" class="form-control" />

                <field type="spacer" name="sp_slider" label="MOD_WMARKA_ARTICLES_SLIDER_SP_SLIDER_LABEL" hr="true" />
                <field name="slidenav" type="radio" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SLIDENAV_LABEL" default="1" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="slidenav_class" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SLIDENAV_SIZE_LABEL" default="uk-slidenav-large" class="form-select">
                    <option value="">MOD_WMARKA_ARTICLES_SLIDER_OPTION_SIZE_DEFAULT</option>
                    <option value="uk-slidenav-large">MOD_WMARKA_ARTICLES_SLIDER_OPTION_SIZE_LARGE</option>
                </field>
                <field name="dotnav" type="radio" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_DOTNAV_LABEL" default="0" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="cols_m" type="list" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_COLS_LABEL" default="uk-child-width-1-3@m" class="form-select">
                    <option value="uk-child-width-1-1@m">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLS_1</option>
                    <option value="uk-child-width-1-2@m">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLS_2</option>
                    <option value="uk-child-width-1-3@m">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLS_3</option>
                    <option value="uk-child-width-1-4@m">MOD_WMARKA_ARTICLES_SLIDER_OPTION_COLS_4</option>
                </field>
            </fieldset>

            <fieldset name="images" label="MOD_WMARKA_ARTICLES_SLIDER_FIELDSET_IMAGES_LABEL">
                <field type="spacer" name="sp_source" label="MOD_WMARKA_ARTICLES_SLIDER_SP_SOURCE_LABEL" hr="true" />
                <field name="image_source" type="list" default="intro" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_SOURCE_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_SOURCE_DESC" class="form-select">
                    <option value="intro">MOD_WMARKA_ARTICLES_SLIDER_OPTION_SOURCE_INTRO</option>
                    <option value="full">MOD_WMARKA_ARTICLES_SLIDER_OPTION_SOURCE_FULL</option>
                </field>
                <field name="image_fallback" type="radio" default="1" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_FALLBACK_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_FALLBACK_DESC" layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="image_processing" type="list" default="juimage" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_PROCESSING_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_PROCESSING_DESC" class="form-select">
                    <option value="juimage">MOD_WMARKA_ARTICLES_SLIDER_OPTION_PROCESSING_JUIMAGE</option>
                    <option value="original">MOD_WMARKA_ARTICLES_SLIDER_OPTION_PROCESSING_ORIGINAL</option>
                </field>
                <field name="image_render" type="list" default="module" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_RENDER_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMAGE_RENDER_DESC" class="form-select">
                    <option value="module">MOD_WMARKA_ARTICLES_SLIDER_OPTION_RENDER_MODULE</option>
                    <option value="layout">MOD_WMARKA_ARTICLES_SLIDER_OPTION_RENDER_LAYOUT</option>
                </field>
                <field name="srcset" type="radio" default="1" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SRCSET_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SRCSET_DESC" layout="joomla.form.field.radio.switcher" showon="image_processing:juimage[AND]image_render:module">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="srcset_widths" type="text" default="400, 800, 1200" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SRCSET_WIDTHS_LABEL" description="MOD_WMARKA_ARTICLES_SLIDER_FIELD_SRCSET_WIDTHS_DESC" class="form-control" showon="image_processing:juimage[AND]image_render:module[AND]srcset:1" />
                <field type="spacer" name="sp_sizes" label="MOD_WMARKA_ARTICLES_SLIDER_SP_SIZES_LABEL" hr="true" />
                <field name="img_w" type="number" default="800" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMGW_LABEL" class="form-control" />
                <field name="img_h" type="number" default="500" label="MOD_WMARKA_ARTICLES_SLIDER_FIELD_IMGH_LABEL" class="form-control" />
